# Leave VITE_APP_MODE=demo to use isolated, persistent browser demo data.
VITE_APP_MODE=demo

# Firebase web configuration. These are public client identifiers, not Admin credentials.
# Set VITE_APP_MODE=firebase only after creating Firestore rules and provisioning memberships.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
